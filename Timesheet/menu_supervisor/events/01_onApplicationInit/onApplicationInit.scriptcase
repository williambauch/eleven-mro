<?php

// MRO-126: Se o usuario nao for inspetor, remove as apps de Finalizacao e Inspecao do menu
// O fluxo de aprovacao (SUPSIG -> PENDING_INSP1 -> PENDING_INSP2 -> COMPLETED)
// e acessivel apenas para supervisores marcados como inspetores.

