if ([usr_is_inspector]) {
    //Esta macro tem por objetivo restaurar os ítens do menu, deletados através da macro "sc_menu_delete".
    sc_reset_menu_delete();
} else {
	// sc_menu_delete remove os itens do menu estatico (nao requer sc_appmenu_create)
    sc_menu_delete("item_5"); // Finalizacao (grid_public_mro_tasks_approval)
    sc_menu_delete("item_6"); // Inspecao (grid_public_mro_tasks_insp)
}	