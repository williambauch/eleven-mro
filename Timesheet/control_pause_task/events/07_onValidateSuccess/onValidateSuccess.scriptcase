<?php

$v_ts_id  = {id_timesheet};
$v_ass_id = {assignment_id};
$v_motivo = {motivo_pausa};
$v_ass_id_sel = {assignment_id_sel};

// 1. Correção de quebra de SQL com addslashes e validação segura (empty)
$v_notas = !empty({passagem_servico}) ? addslashes({passagem_servico}) : 'Pausa rotineira (Almoço / Descanso)';

// 2. Correção: Trocado $v_decisao por $v_motivo em toda a estrutura
if($v_motivo == 1) {
    // ROTA 1: PAUSA CURTA (Mantém com o mecânico, apenas pausa)
    $motivo_txt = '';
    $status_code = 'PAUSED';
    $status_ts = 'PAUSED';
    $status_type = "Pausa Curta (Almoço / Descanso) - Notas: $v_notas";
	
} elseif (in_array($v_motivo, [3, 4, 5])) {
    // ROTA 2: IMPEDIMENTOS / GARGALOS (Alerta as áreas de apoio!)
    $motivo_txt = ($v_motivo == 3) ? 'Falta de Material' : (($v_motivo == 4) ? 'Aguardando Ferramenta / GSE' : 'Inspetor / Engenharia');
    $status_code = 'BLOCKED';
    $status_ts = 'PAUSED';
    $status_type = "Impedimento: $motivo_txt - Notas: $v_notas";
	
    // Mapeando a decisão para true/false 
    $b_mat  = ($v_motivo == 3) ? 'true' : 'false';
    $b_ferr = ($v_motivo == 4) ? 'true' : 'false';
    $b_mao  = ($v_motivo == 5) ? 'true' : 'false';

    $sql_flags = "UPDATE mro_tasks 
                  SET is_blocked_material = $b_mat, 
                      is_blocked_tool = $b_ferr, 
                      is_blocked_labor = $b_mao 
                  WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = $v_ass_id)";
    sc_exec_sql($sql_flags);
	
} elseif ($v_motivo == 2) { 
    // ROTA 3: FIM DE TURNO / REPASSE

    // MRO-UAT-FR03: Mecanico precisa devolver as ferramentas em posse dele
    // NESTA JIC (task_id) antes de encerrar a participacao na atribuicao
    // (repasse/fim de turno). Ferramentas de outras JICs nao bloqueiam aqui.
    $var_emp_id_fr03 = "SELECT employee_id, task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id;
    sc_lookup(rs_emp_fr03, $var_emp_id_fr03);
    if (!empty({rs_emp_fr03})) {
        $var_emp_fr03 = (int){rs_emp_fr03[0][0]};
        $var_task_emp_fr03 = (int){rs_emp_fr03[0][1]};
        sc_lookup(rs_tools_emp, "SELECT COUNT(*) FROM mro_tool_transactions
                                 WHERE employee_id = $var_emp_fr03
                                   AND task_id = $var_task_emp_fr03
                                   AND status = 'ACTIVE'");
        $var_pend_emp = (!empty({rs_tools_emp})) ? (int){rs_tools_emp[0][0]} : 0;
        if ($var_pend_emp > 0) {
            sc_error_message("Ação Bloqueada: você possui $var_pend_emp ferramenta(s) em custódia nesta JIC. Devolva as ferramentas no terminal antes de encerrar a participação. Consulte o botão 'Custódia' na tela do cronômetro para ver a lista.");
            sc_error_exit();
        }
    }

    // Verifica se é o último mecânico ativo na tarefa
    $var_sql_count = "SELECT COUNT(*) FROM mro_task_assignments
                      WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id . ")
                        AND status_code IN ('IN_PROGRESS', 'PAUSED', 'BLOCKED')
                        AND assignment_id <> " . (int)$v_ass_id;
    sc_lookup(rs_count_ativos, $var_sql_count);
    $var_outros_ativos = !empty({rs_count_ativos}) ? (int){rs_count_ativos[0][0]} : 0;
    
    if ($var_outros_ativos > 0) {
        // Ainda há outros mecânicos ativos — encerra a participacao deste
        $motivo_txt = '';
        $status_code = 'PENDING_HANDOVER';
        $status_ts = 'COMPLETED';
        $status_type = "Repasse de Turno - Outros mecânicos ativos - Notas: $v_notas";
        // Nao altera a task mae (outro mecânico continua)
    } else {
        // Último mecânico — faz o handover para Programacao
        $motivo_txt = '';
        $status_code = 'PENDING_HANDOVER';
        $status_ts = 'COMPLETED';
        $status_type = "Repasse de Turno - Enviado a Programacao - Notas: $v_notas";
        
        // MRO-120: Atualiza task mae para PENDING_PROG, sem pendencia de MO
        $var_task_id_sql = "SELECT task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id;
        sc_lookup(rs_task, $var_task_id_sql);
        if (!empty({rs_task})) {
            $var_tid = (int){rs_task[0][0]};
            sc_exec_sql("UPDATE mro_tasks SET status_code = 'PENDING_PROG', is_blocked_labor = FALSE WHERE task_id = $var_tid");
            sc_exec_sql("INSERT INTO mro_task_history (task_id, action_taken, user_login) 
                         VALUES ($var_tid, 'SENT_TO_PROG_VIA_HANDOVER', '[usr_login]')");
        }
    }
	
} elseif ($v_motivo == 6) { 
    // ROTA 4: CONCLUSÃO — "Timesheet Finalizado/Tarefa Concluída"
    // Conclui o timesheet DO MECANICO (individual). A task so vai para
    // SUPSIG (Inspecao) quando o ULTIMO mecanico ativo encerrar.

    // MRO-UAT-FR03: O mecanico precisa devolver as ferramentas em posse DELE
    // NESTA JIC (task_id) antes de finalizar o timesheet. Ferramentas de
    // outras JICs nao bloqueiam a conclusao desta.
    $var_emp_id_fr03 = "SELECT employee_id, task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id;
    sc_lookup(rs_emp_fr03, $var_emp_id_fr03);
    if (!empty({rs_emp_fr03})) {
        $var_emp_fr03 = (int){rs_emp_fr03[0][0]};
        $var_task_emp_fr03 = (int){rs_emp_fr03[0][1]};
        sc_lookup(rs_tools_emp, "SELECT COUNT(*) FROM mro_tool_transactions
                                 WHERE employee_id = $var_emp_fr03
                                   AND task_id = $var_task_emp_fr03
                                   AND status = 'ACTIVE'");
        $var_pend_emp = (!empty({rs_tools_emp})) ? (int){rs_tools_emp[0][0]} : 0;
        if ($var_pend_emp > 0) {
            sc_error_message("Ação Bloqueada: você possui $var_pend_emp ferramenta(s) em custódia nesta JIC. Devolva as ferramentas no terminal antes de finalizar o timesheet. Consulte o botão 'Custódia' na tela do cronômetro para ver a lista.");
            sc_error_exit();
        }
    }

    // MRO-UAT-FR03: Se for o ULTIMO mecanico ativo, a JIC vai para Inspecao
    // (SUPSIG) — bloqueia por task_id inteira para pegar ferramentas orfas
    // de mecanicos que ja sairam da task.
    $var_sql_count6 = "SELECT COUNT(*) FROM mro_task_assignments
                       WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id . ")
                         AND status_code IN ('IN_PROGRESS', 'PAUSED', 'BLOCKED')
                         AND assignment_id <> " . (int)$v_ass_id;
    sc_lookup(rs_count6, $var_sql_count6);
    $var_outros6 = (!empty({rs_count6})) ? (int){rs_count6[0][0]} : 0;

    if ($var_outros6 == 0) {
        $var_task_id_fr03 = "SELECT task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id;
        sc_lookup(rs_task_fr03, $var_task_id_fr03);
        if (!empty({rs_task_fr03})) {
            $var_tid_fr03 = (int){rs_task_fr03[0][0]};
            sc_lookup(rs_tools_pend, "SELECT COUNT(*) FROM mro_tool_transactions
                                      WHERE task_id = $var_tid_fr03 AND status = 'ACTIVE'");
            $var_pendentes = (!empty({rs_tools_pend})) ? (int){rs_tools_pend[0][0]} : 0;
            if ($var_pendentes > 0) {
                sc_error_message("Ação Bloqueada: existem $var_pendentes ferramenta(s) em custódia na JIC sem devolução. A JIC não pode ir para Inspeção com ferramentas pendentes. Consulte o botão 'Custódia' na tela do cronômetro para ver a lista.");
                sc_error_exit();
            }
        }
    }

    $motivo_txt = '';
    $status_code = 'SUPSIG';
    $status_ts = 'COMPLETED';
    $status_type = "Timesheet Finalizado/Tarefa Concluída.";
} else {
	// SEGURANÇA: Se o motivo vier vazio ou não mapeado, cancela a operação
	sc_error_message("Motivo de ação não identificado.");
	sc_error_exit();
}

// 1. Fecha o Timesheet atual (Calculando os minutos no Postgres)
$sql_ts1 = "UPDATE mro_timesheet 
            SET end_time = NOW(), 
                status = '$status_ts', 
                pause_reason = '$motivo_txt',
                handover_notes = '$v_notas',
                duration_minutes = ROUND(EXTRACT(EPOCH FROM (NOW() - start_time)) / 60)
            WHERE timesheet_id = $v_ts_id";
sc_exec_sql($sql_ts1);

// MRO-120: Atualiza actual_qty_hours no assignment
sc_exec_sql("UPDATE mro_task_assignments
             SET actual_qty_hours = (
                 SELECT COALESCE(SUM(duration_minutes), 0)::numeric / 60
                 FROM mro_timesheet
                 WHERE assignment_id = $v_ass_id
                 AND duration_minutes IS NOT NULL
             )
             WHERE assignment_id = $v_ass_id");

// MRO-123: Ao CONCLUIR a task (SUPSIG) e nao restar outro assignment ativo,
// preenche actual_end se estiver vazio. Nao sobrescreve datas manuais (DIGEX).
if ($status_code == 'SUPSIG') {
    sc_exec_sql("UPDATE mro_tasks
                 SET actual_end = COALESCE(actual_end, NOW())
                 WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = $v_ass_id)
                   AND actual_end IS NULL
                   AND NOT EXISTS (
                       SELECT 1 FROM mro_task_assignments
                       WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = $v_ass_id)
                         AND status_code IN ('IN_PROGRESS','PAUSED','BLOCKED','PENDING_HANDOVER','SUPSIG')
                         AND assignment_id <> $v_ass_id
                   )");
}

// MRO-126: Quando o ultimo assignment conclui (SUPSIG), a task tambem vai para SUPSIG
if ($status_code == 'SUPSIG') {
    sc_exec_sql("UPDATE mro_tasks
                 SET status_code = 'SUPSIG',
                     updated_at = CURRENT_TIMESTAMP
                 WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = $v_ass_id)
                   AND status_code IN ('IN_PROGRESS','PENDING_PROG','PAUSED')
                   AND NOT EXISTS (
                       SELECT 1 FROM mro_task_assignments
                       WHERE task_id = (SELECT task_id FROM mro_task_assignments WHERE assignment_id = $v_ass_id)
                         AND status_code IN ('IN_PROGRESS','PAUSED','BLOCKED','ASSIGNED','PENDING_HANDOVER')
                         AND assignment_id <> $v_ass_id
                   )");

    // MRO-126: Registra a conclusao (SUPSIG) no historico da task
    $var_tid_supsig = "SELECT task_id FROM mro_task_assignments WHERE assignment_id = " . (int)$v_ass_id;
    sc_lookup(rs_tid_supsig, $var_tid_supsig);
    if (!empty({rs_tid_supsig})) {
        $var_task_supsig = (int){rs_tid_supsig[0][0]};
        sc_exec_sql("INSERT INTO mro_task_history (task_id, action_taken, user_login, remarks)
                     VALUES (" . $var_task_supsig . ", 'SUPSIG', '[usr_login]', 'Ultimo clock-out - Timesheet Finalizado/Tarefa Concluida: IN_PROGRESS -> SUPSIG')");
    }
}

// 2. Registra o Evento de Auditoria
$sql_ev = "INSERT INTO mro_assignment_events 
           (assignment_id, timesheet_id, event_type, performed_by_id, description) 
           VALUES ($v_ass_id, $v_ts_id, '$status_code', [usr_employee_id], '$status_type')";
sc_exec_sql($sql_ev);

// 3. Muda a tarefa atual para o Status correspondente da Rota
$sql_pause2 = "UPDATE mro_task_assignments 
               SET status_code = '$status_code' 
               WHERE assignment_id = $v_ass_id";
sc_exec_sql($sql_pause2);

// ========================================================
// ROTA 5: O MECÂNICO ESCOLHEU PULAR PARA UMA NOVA TAREFA
// ========================================================
if (!empty($v_ass_id_sel) && $v_ass_id_sel != $v_ass_id) {
	
    // MRO-115: Verifica se a tarefa de destino esta bloqueada por material
    sc_lookup(ds_block_dest, "SELECT t.is_blocked_material 
                              FROM mro_tasks t 
                              JOIN mro_task_assignments a ON a.task_id = t.task_id 
                              WHERE a.assignment_id = $v_ass_id_sel");
    if (!empty({ds_block_dest}) && ({ds_block_dest[0][0]} == 't' || {ds_block_dest[0][0]} == 'true' || {ds_block_dest[0][0]} == 1)) {
        sc_error_message("A tarefa de destino esta bloqueada por falta de material. Selecione outra tarefa.");
        sc_error_exit();
    }	
	
	// Gera novo relógio (Timesheet)
	$sql_ts = "INSERT INTO mro_timesheet (assignment_id, employee_id, appointment_date, start_time, status) 
               VALUES ($v_ass_id_sel, [usr_employee_id], CURRENT_DATE, NOW(), 'IN_PROGRESS')
               RETURNING timesheet_id";
	sc_lookup(rs_novo_id, $sql_ts);
	
	$id_ts = 0;
	if (!empty({rs_novo_id[0][0]})) {
		$id_ts = {rs_novo_id[0][0]};
	}

    [glo_timesheet_id] = $id_ts; // Guarda na sessão o NOVO cronômetro

    // Grava auditoria na nova tarefa apontada
	$sql_ev2 = "INSERT INTO mro_assignment_events (assignment_id, timesheet_id, event_type, performed_by_id) 
                VALUES ($v_ass_id_sel, $id_ts, 'START', [usr_employee_id])";
    sc_exec_sql($sql_ev2);
	
	// 3. Muda a nova tarefa para Em Progresso (Removido update 'PAUSED' redundante que existia antes)
	$sql_prog = "UPDATE mro_task_assignments 
                 SET status_code = 'IN_PROGRESS' 
                 WHERE assignment_id = $v_ass_id_sel";
	sc_exec_sql($sql_prog);
}

// Comita transações no banco
sc_commit_trans();
	
// Limpa a sessão e fecha o Modal
sc_reset_global([glo_current_timesheet]); 
echo "<script> window.parent.tb_remove(); window.parent.location.reload(); </script>";
