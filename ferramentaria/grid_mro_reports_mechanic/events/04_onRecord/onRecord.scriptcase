<?php

{var_tipo_condition_on_return} = ({condition_on_return} == 'PERDA') ? 'TF-60-041' : 'TF-60-013';

switch({condition_on_return}) {
	
	case 'DANO':
		sc_change_css('sc_badge', 'yellow', 'condition_on_return');
		break;
		
	case 'PERDA':
		sc_change_css('sc_badge', 'red', 'condition_on_return');
		break;
}
