 $contacts .= [total_chked][$x]."<br>"; 			

}
	

$tb2 = "<table cellpadding='4' cellspacing='2'>
       <tr>
         <td colspan='2' border='none'><strong> (".$tot.") NRs Reprovadas: <strong></td>
      </tr>
      <tr>                      
        <td border='none'><font color='#003366'><strong>  ".$contacts." </strong></font> </td>         
       </tr>
</table>";

