<?php

// onLoadRecord
// MRO-120: Exibe horas consumidas vs orcadas para este recurso

$var_task_id  = (int){task_id};
$var_res_code = addslashes({resource_code});
$var_orcado   = (float){budgeted_hours};

// Soma as horas efetivamente trabalhadas (assignments finalizados)
$var_sql = "SELECT COALESCE(SUM(a.actual_qty_hours), 0)
            FROM mro_task_assignments a
            JOIN mro_skills s ON s.skill_id = a.skill_id
            WHERE a.task_id = $var_task_id
              AND s.skill_code = '$var_res_code'
              AND a.status_code IN ('PENDING_HANDOVER', 'SUPSIG')";
sc_lookup(rs_consumo, $var_sql);

$var_consumido = 0;
if (!empty({rs_consumo})) {
    $var_consumido = (float){rs_consumo[0][0]};
}

{consumed_hours} = number_format($var_consumido, 2, ',', '.') ;

// MRO-121: Se a task esta em status final ou liberado (RELEASED),
// desativa os botoes de edicao/exclusao — o trabalho ja foi distribuido
if ($var_task_id > 0) {
    sc_lookup(rs_status_task, "SELECT status_code FROM mro_tasks WHERE task_id = $var_task_id");

    if (!empty({rs_status_task})) {
        $var_status_task = {rs_status_task[0][0]};

        // Status em que os recursos nao podem mais ser alterados
        $var_status_bloqueados = [
            'RELEASED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED',
            'PENDING_HANDOVER', 'SUPSIG', 'CLOSED', 'APPROVED'
        ];

        if (in_array($var_status_task, $var_status_bloqueados)) {
            sc_btn_display('new', 'off');
            sc_btn_display('update', 'off');
            sc_btn_display('delete', 'off');
            sc_btn_display('copy', 'off');
        } else {
            sc_btn_display('new', 'on');
            sc_btn_display('update', 'on');
            sc_btn_display('delete', 'on');
            sc_btn_display('copy', 'on');
        }
    }
}
