<?php

// ====================================================================
// MRO-126: Aprovação da task pelo Supervisor (SUPSIG -> COMPLETED/PENDING_INSP1)
// Botão AJAX da barra de ação com 2 estados:
//   state1 -> "Aprovar"   (botão ativo)
//   state2 -> "Aprovado"  (feedback visual após aprovar)
//
// Fluxo:
//  - Task sem RII (requires_rii=false E is_rii=false) -> COMPLETED
//  - Task com RII (requires_rii=true OU is_rii=true)   -> PENDING_INSP1
//
// Idempotente: UPDATE com WHERE status_code = 'SUPSIG' garante que
// a task só é aprovada uma única vez (race condition segura).
//
// ====================================================================
// DOCUMENTAÇÃO DOS CAMPOS RII 
// ====================================================================
// requires_rii e is_rii são DOIS conceitos distintos (NÃO são redundantes):
//
//   | Campo          | Significado                                                | Tipo de inspeção            |
//   |----------------|------------------------------------------------------------|-----------------------------|
//   | requires_rii   | "Esta task REQUER uma inspeção RII" (precisa passar por      | Inspeção Simples (1 inspetor)|
//   |                |  inspeção antes da conclusão)                                |                             |
//   | is_rii         | "Esta task É um item RII" (vem da lista de itens críticos     | Duplo Check (2 inspetores)  |
//   |                |  RII/IIO)                                                   |                             |
//
//   | Combinação                          | Interpretação                     |
//   |-------------------------------------|-----------------------------------|
//   | requires_rii=false E is_rii=false   | Tarefa comum (sem inspeção)       |
//   | requires_rii=false E is_rii=true    | Item RII — duplo check            |
//   | requires_rii=true  E is_rii=true    | Requer + é RII                    |
//   | requires_rii=true  E is_rii=false   | Requer inspeção simples           |
//
// No fluxo de aprovação:
//   - Se requires_rii=true OU is_rii=true  -> a task vai para PENDING_INSP1 (fila de inspeção)
//   - Se requires_rii=false E is_rii=false -> a task vai direto para COMPLETED
//
// O desdobramento (simples vs duplo check) acontece na assinatura do
// Inspetor 1 (grid_public_mro_task_assignments_insp): is_rii=true leva a
// task para PENDING_INSP2 (segundo inspetor); requires_rii apenas conclui.
// ====================================================================

// 1. Recupera o estado atual do botão no momento do clique
$var_estado = sc_actionbar_clicked_state();

// 2. Se já estiver no estado "Aprovado" (state2), não faz nada
if ($var_estado == 'state2') {
    sc_ajax_message("Esta tarefa já foi aprovada.", "Aprovação");
    return;
}

$var_task_id = (int){task_id};

if ($var_task_id <= 0) {
    sc_ajax_message("Parâmetros inválidos para a aprovação.");
    return;
}

// 3. Re-checa o status e as flags RII da task
$var_sql = "SELECT status_code, requires_rii, is_rii
            FROM mro_tasks
            WHERE task_id = " . $var_task_id;
sc_lookup(rs_task, $var_sql);

if ({rs_task} === false) {
    sc_ajax_message("Erro ao consultar a tarefa.", "Erro");
    return;
}

if (empty({rs_task})) {
    sc_ajax_message("Tarefa não encontrada.", "Erro");
    return;
}

// 4. Só processa se a task ainda estiver SUPSIG (evita re-aprovação)
if ({rs_task[0][0]} != 'SUPSIG') {
    sc_actionbar_state('btn_aprovar', 'state2');
    sc_actionbar_disable('btn_aprovar');
    sc_ajax_message("Esta tarefa já foi processada (status atual: " . {rs_task[0][0]} . ").", "Aprovação");
    return;
}

$var_req_rii = ({rs_task[0][1]} == 't' || {rs_task[0][1]} === true || {rs_task[0][1]} == 1);
$var_is_rii  = ({rs_task[0][2]} == 't' || {rs_task[0][2]} === true || {rs_task[0][2]} == 1);

$var_destino = ($var_req_rii || $var_is_rii) ? 'PENDING_INSP1' : 'COMPLETED';
$var_acao    = ($var_req_rii || $var_is_rii) ? 'ROUTED_TO_INSP1' : 'APPROVED';

// 5. Transação atômica: atualiza a task + grava evento de auditoria
sc_begin_trans();

// Auditoria antes de executar  
$var_desc = "Task " . $var_task_id . " aprovada pelo supervisor: SUPSIG -> " . $var_destino .
            " (requires_rii=" . ($var_req_rii ? 'true' : 'false') .
            ", is_rii=" . ($var_is_rii ? 'true' : 'false') . ")";
sc_log_add("task_approve", $var_desc);

sc_exec_sql("UPDATE mro_tasks
             SET status_code = '" . $var_destino . "',
                 updated_at = CURRENT_TIMESTAMP
             WHERE task_id = " . $var_task_id . "
               AND status_code = 'SUPSIG'");

// 6. Registra a transição de status no histórico da task (auditoria exclusiva de task)
sc_exec_sql("INSERT INTO mro_task_history (task_id, action_taken, user_login, remarks)
             VALUES (" . $var_task_id . ", '" . $var_acao . "', '[usr_login]', '" . addslashes($var_desc) . "')");

sc_commit_trans();

// 7. Feedback visual: muda o botão para o estado "Aprovado" (state2)
sc_actionbar_state('btn_aprovar', 'state2');
sc_actionbar_disable('btn_aprovar');

// 8. Recarrega a linha da grid para refletir o novo status
sc_ajax_refresh();

sc_ajax_message("Tarefa aprovada! Status alterado para: " . $var_destino, "Aprovação");
