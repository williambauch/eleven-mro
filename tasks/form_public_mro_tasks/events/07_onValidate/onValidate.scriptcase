<?php

// Campos obrigatórios para Não-Rotina (NRC)
if (!empty({is_nrc})) {

    if (empty({parent_task_id})) {
        sc_error_message("O campo Task Origem (Parent) é obrigatório para Não-Rotinas.");
        sc_error_exit();
    }

    if (empty({instruction_text})) {
        sc_error_message("O campo Instrução é obrigatório para Não-Rotinas.");
        sc_error_exit();
    }

    if (empty({task_name})) {
        sc_error_message("O campo Nome da Tarefa é obrigatório para Não-Rotinas.");
        sc_error_exit();
    }
}


// ====================================================================
// MRO-115 VALIDACAO DO CAMPO Skill_Code
// ====================================================================
// O campo Skill_Code e obrigatorio pois e utilizado na montagem do
// codigo de barras do Pack JIC (posicao 34-35 do barcode).

if (empty({Skill_Code})) {
    sc_error_message("O campo Skill Code e obrigatÓrio. Ele e utilizado na geração do código de barras do Pack JIC.");
    sc_error_exit();
}
