<?php

// ====================================================================
// DELETE NAO PASSA PELAS VALIDACOES DE OBRIGATORIEDADE
// ====================================================================
if (!sc_btn_delete) {

    // Campos obrigatórios para Não-Rotina (NRC)
    if (!empty({is_nrc})) {

        if (empty({parent_task_id})) {
            sc_error_message("O campo Task Origem (Parent) é obrigatório para Não-Rotinas.");
            sc_error_exit();
        }

        if (empty({instruction_text})) {
            sc_error_message("O campo Instrução (Discrepancy) é obrigatório para Não-Rotinas.");
            sc_error_exit();
        }

        if (empty({task_name})) {
            sc_error_message("O campo Nome da Tarefa é obrigatório para Não-Rotinas.");
            sc_error_exit();
        }
    }


    // ====================================================================
    // MRO-115 VALIDACAO DO CAMPO Skill_Code
    // ====================================================================
    // O campo Skill_Code e obrigatorio pois e utilizado na montagem do
    // codigo de barras do Pack JIC (posicao 34-35 do barcode).

    if (empty({Skill_Code})) {
        sc_error_message("O campo Skill Code e obrigatÓrio. Ele e utilizado na geração do código de barras do Pack JIC.");
        sc_error_exit();
    }

    // ====================================================================
    // MRO-126 VALIDACAO DE DATAS DE PLANEJAMENTO (apenas rotinas)
    // ====================================================================
    // Se a ROTINA tiver fase definida (phase_code preenchido no select),
    // exige target_start e target_end - evita task com fase mas sem datas,
    // que fica sem barra no Gantt. NRCs seguem a fase da rotina de origem.


    if (empty({is_nrc}) && !empty({phase_code})) {
        // target_start/end podem vir como string 'null' quando nao preenchidos
        $var_ts_vazio = (empty({target_start}) || {target_start} == 'null' || {target_start} == 'NULL');
        $var_te_vazio = (empty({target_end})   || {target_end} == 'null' || {target_end} == 'NULL');

        if ($var_ts_vazio) {
            sc_error_message("Fase definida: o campo Inicio (target_start) e obrigatorio para o planejamento no Gantt.");
            sc_error_exit();
        }
        if ($var_te_vazio) {
            sc_error_message("Fase definida: o campo Fim (target_end) e obrigatorio para o planejamento no Gantt.");
            sc_error_exit();
        }
    }

}
