<?php

// ScriptInit da grid_public_mro_tasks
// Aplica filtros automaticos na consulta: project_id via global e,
// para usuarios com perfil exclusivo MECANICO, filtra por created_by.
// ====================================================================
// 1. TRADUZ group_id da sessao para nomes legiveis (ex: 3 → MECANICO)
// ====================================================================
$ids_brutos = is_array([usr_groups]) ? implode(',', [usr_groups]) : [usr_groups];
$ids_brutos = str_replace(' ', '', $ids_brutos);

$meus_grupos_nomes = [];

if (!empty($ids_brutos)) {
    sc_lookup(rs_grupos, "SELECT description FROM sec_groups WHERE group_id IN ($ids_brutos)");
    if (!empty({rs_grupos})) {
        foreach ({rs_grupos} as $grupo) {
            $meus_grupos_nomes[] = strtoupper(trim($grupo[0]));
        }
    }
}

// ====================================================================
// 2. MONTA WHERE UNICO (filtros combinados num so sc_select_where)
// ====================================================================
$var_cond = "";

// Filtro 1: se for MECANICO com perfil unico, ve apenas as proprias tasks
$quantidade_perfis = count($meus_grupos_nomes);
if ($quantidade_perfis == 1 && in_array('MECANICO', $meus_grupos_nomes)) {
    $var_usuario = [usr_login];
    $var_cond = "created_by = '$var_usuario'";
}

// Filtro 2: se veio de um projeto especifico, filtra por ele
if (!empty([var_project_id])) {
    $var_pid = [var_project_id];
    if ($var_cond != "") {
        $var_cond .= " AND project_id = $var_pid";
    } else {
        $var_cond = "project_id = $var_pid";
    }
}

// Filtro 3: se veio do dashboard com filtro de status, aplica (glo_filtro_status)
// Valores (mesmos do dash MRO-123): EXECUCAO, ENCERRADAS, BLOQUEADAS ou vazio (todas)
if (!empty([glo_filtro_status])) {
    $var_status = trim([glo_filtro_status]);
    $var_cond_status = "";

    if ($var_status == 'EXECUCAO') {
        $var_cond_status = "status_code IN ('IN_PROGRESS','RELEASED','PAUSED','BLOCKED')";
    } elseif ($var_status == 'ENCERRADAS') {
        $var_cond_status = "status_code = 'COMPLETED'";
    } elseif ($var_status == 'BLOQUEADAS') {
        $var_cond_status = "(status_code IN ('BLOCKED','PENDING','PENDING_OA','PENDING_ENG','PENDING_PROG','PENDING_COORD','COMMERCIAL_REVIEW','WAITING_CUSTOMER')
            OR is_blocked_material OR is_blocked_tool OR is_blocked_labor OR is_blocked_predecessor OR is_predecessor_manual
            OR pending_id IS NOT NULL)";
    } elseif ($var_status == 'MATERIAL') {
        // Prioridade 1 no CASE do dash: pega todas com material
        $var_cond_status = "is_blocked_material";
    } elseif ($var_status == 'FERRAMENTA') {
        // Prioridade 2: exclui as que ja caem em material
        $var_cond_status = "is_blocked_tool AND NOT is_blocked_material";
    } elseif ($var_status == 'MAO_OBRA') {
        // Prioridade 3: exclui as que ja caem em material/ferramenta
        $var_cond_status = "is_blocked_labor AND NOT is_blocked_material AND NOT is_blocked_tool";
    } elseif ($var_status == 'PREDECESSORA') {
        // Prioridade 4: exclui as que ja caem em material/ferramenta/mao de obra
        $var_cond_status = "is_blocked_predecessor AND NOT is_blocked_material AND NOT is_blocked_tool AND NOT is_blocked_labor";
    } elseif ($var_status == 'PRED_MANUAL') {
        // Prioridade 5 (ultima flag): exclui as que ja caem em qualquer flag anterior
        $var_cond_status = "is_predecessor_manual AND NOT is_blocked_material AND NOT is_blocked_tool AND NOT is_blocked_labor AND NOT is_blocked_predecessor";
    } elseif (strpos($var_status, 'PEND_') === 0) {
        $var_pend_id = (int)substr($var_status, 5);
        if ($var_pend_id > 0) {
            $var_cond_status = "pending_id = " . $var_pend_id;
        }
    }

    if ($var_cond_status != "") {
        if ($var_cond != "") {
            $var_cond .= " AND " . $var_cond_status;
        } else {
            $var_cond = $var_cond_status;
        }
    }
}

// Aplica o WHERE completo (respeita sc_where_atual se ja existir)
if ($var_cond != "") {
    if (empty({sc_where_atual})) {
        sc_select_where(add) = "WHERE $var_cond";
    } else {
        sc_select_where(add) = "AND $var_cond";
    }

  // Limpa as globals de filtro para nao ficar com o filtro travado
  [var_project_id] = '';
  [glo_filtro_status] = '';
}

// ====================================================================
// 3. ALERTA DE MENSAGEM (vindo do botao RUN)
// ====================================================================

// Verifica se existe alguma mensagem vinda do botão RUN
if (!empty([glo_aviso_run])) {    
    // Limpa a variável imediatamente para a mensagem não ficar repetindo
    // toda vez que o usuário mudar de página ou pesquisar algo na Grid.    
    sc_alert([glo_aviso_run]);
    [glo_aviso_run] = '';
}





?>
<script>
// MRO-119: Desabilitar checkbox RUN se a task estiver bloqueada por predecessora
// MRO-126: desabilita tambem quando o status da linha nao permite liberacao
// (so liberam: PLANNING, NOT_STARTED, PLANNED, APPROVED)
function esconderCheckboxRun() {
  const statusPermitidos = ['PLANNING', 'NOT_STARTED', 'PLANNED', 'APPROVED'];
  const predSpans = document.querySelectorAll("span[id^='id_sc_field_btn_predecessor_']");
  predSpans.forEach(span => {
    const match = span.id.match(/id_sc_field_btn_predecessor_(\d+)$/);
    if (!match) return;

    const linhaNum = match[1];
    const innerSpan = span.querySelector('span[data-blocked]');
    if (!innerSpan) return;

    const blocked = innerSpan.getAttribute('data-blocked');
    const status = innerSpan.getAttribute('data-status');
    const statusOk = statusPermitidos.indexOf(status) !== -1;
    const checkbox = document.getElementById('NM_ck_run' + linhaNum);

    if (checkbox && (blocked === '1' || !statusOk)) {
      checkbox.disabled = true;
      checkbox.checked = false;
      checkbox.closest('td').style.opacity = '0.4';
    }
  });
}

setTimeout(esconderCheckboxRun, 1);

$(document).ajaxComplete(function () {
  setTimeout(esconderCheckboxRun, 1);
});

document.addEventListener("DOMContentLoaded", function () {
  // MRO-119: Sobrescreve funcao nativa do ScriptCase para nao selecionar checkboxes desabilitados
  window.nm_marca_check_grid = function(obj_mark) {
    $(".sc-ui-check-run").each(function() {
      if (!this.disabled) {
        this.checked = obj_mark.checked;
      }
    });
  };
});
</script>

<?php
