<?php

// Evento Ajax do campo {material_id} - Trigger: onChange
// Ao trocar o material:
//   1. Carrega o custo unitario do material master (mro_materials)
//   2. Calcula total_cost = planned_qty * unit_cost e preenche os totais
// Mesma origem de custo usada no import control_import_empenhos.

$var_material_id = (int){material_id};

if ($var_material_id > 0) {
    $var_sql = "SELECT unit_cost, description
                FROM mro_materials
                WHERE material_id = " . $var_material_id;
    sc_lookup(rs_mat, $var_sql);

    if ({rs_mat} === false) {
        sc_ajax_message("Erro ao consultar o material.");
        return;
    }

    if (empty({rs_mat})) {
        sc_ajax_message("Material nao encontrado.");
        return;
    }

    // So preenche o custo se o campo estiver vazio (respeita custo manual digitado)
    if (empty({unit_cost}) || (float){unit_cost} <= 0) {
        {unit_cost} = {rs_mat[0][0]};
    }

    // Recalcula os totais com os valores em tela
    mCalcularTotaisEmTela();
}
