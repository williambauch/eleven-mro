<?php

$hoje = date('Y-m-d');
$data_vencimento = {calibration_due_date};

if (!empty($data_vencimento)) {
    if ($data_vencimento < $hoje) {
        // Vencida: Fundo vermelho claro, texto escuro
        sc_field_style({calibration_due_date}, '#FFCCCC', '15px', '#000000', 'Arial', 'bold');
        sc_field_style({tool_id}, '#FFCCCC', '15px', '#000000', 'Arial', 'bold');
    } elseif ($data_vencimento <= date('Y-m-d', strtotime('+15 days'))) {
        // Vence em 15 dias: Amarelo alerta
        sc_field_style({calibration_due_date}, '#FFFFCC', '15px', '#000000', 'Arial', 'bold');
    }
}

// Badge nativo do ScriptCase para o status da ferramenta
switch({status}) {
    case 'AVAILABLE':
        sc_change_css('sc_badge', 'green', 'status');
        break;

    case 'FERRAMENTA EM EMPRESTIMO':
        sc_change_css('sc_badge', 'blue', 'status');
        break;

    case 'FERRAMENTA EM CALIBRAÇÃO':
        sc_change_css('sc_badge', 'yellow', 'status');
        break;

    case 'FERRAMENTA DANIFICADA':
        sc_change_css('sc_badge', 'orange', 'status');
        break;

    case 'FERRAMENTA EXTRAVIADA':
        sc_change_css('sc_badge', 'red', 'status');
        break;
}
