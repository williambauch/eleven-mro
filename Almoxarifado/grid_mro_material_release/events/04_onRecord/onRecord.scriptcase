<?php

// ====================================================================
// onRecord da grid_mro_material_release (Provedoria - Gated Process)
// Formata visualmente o percentual de disponibilidade de materiais.
// ====================================================================

// Badge de percentual de disponibilidade
$var_pct = (int){pct_disponivel};

if ($var_pct >= 100) {
    // 100% disponivel: badge verde (pronto para liberar)
    {pct_disponivel} = "<span style='background:#d1e7dd; color:#0f5132; border:1px solid #198754; border-radius:12px; padding:2px 10px; font-weight:bold; font-size:12px;'><i class='fa-solid fa-circle-check'></i> {$var_pct}%</span>";
} elseif ($var_pct > 0) {
    // Parcial: badge amarelo
    {pct_disponivel} = "<span style='background:#fff3cd; color:#664d03; border:1px solid #ffc107; border-radius:12px; padding:2px 10px; font-weight:bold; font-size:12px;'><i class='fa-solid fa-triangle-exclamation'></i> {$var_pct}%</span>";
} else {
    // 0%: badge vermelho
    {pct_disponivel} = "<span style='background:#f8d7da; color:#842029; border:1px solid #dc3545; border-radius:12px; padding:2px 10px; font-weight:bold; font-size:12px;'><i class='fa-solid fa-box-open'></i> {$var_pct}%</span>";
}

// Indicador de disponibilidade de materiais (X de Y)
$var_ok = {materiais_ok};
$var_total = {total_materiais};
{materiais_ok} = "{$var_ok} de {$var_total}";
