<?php

// ====================================================================
// ScriptInit da grid_mro_material_release (Provedoria - Gated Process)
// Aplica filtro opcional por projeto (var_project_id) vindo do menu/dash.
// ====================================================================

$var_cond = "";

// Filtro 1: se veio de um projeto especifico, filtra por ele
if (!empty([var_project_id])) {
    $var_pid = (int)[var_project_id];
    $var_cond = "t.project_id = $var_pid";
}

// Aplica o WHERE completo (respeita sc_where_atual se ja existir)
if ($var_cond != "") {
    if (empty({sc_where_atual})) {
        sc_select_where(add) = "WHERE $var_cond";
    } else {
        sc_select_where(add) = "AND $var_cond";
    }

    // Limpa a global de filtro para nao travar a tela
    [var_project_id] = '';
}
