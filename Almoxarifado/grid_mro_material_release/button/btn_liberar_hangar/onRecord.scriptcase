<?php

// ====================================================================
// BOTÃO POR LINHA: btn_liberar_hangar (grid_mro_material_release)
// Libera a JIC para o hangar somente se 100% dos materiais bloqueantes
// estiverem disponíveis no estoque físico (Gated Process).
// ====================================================================

$var_task_id = (int){task_id};
$var_jic     = {jic};
$var_status  = {status_code};
$var_user    = [usr_login];

// ====================================================================
// 1. DOUBLE-CHECK DE SEGURANCA: revalida no momento do clique que
//    ainda nao existe NENHUM material faltante para esta JIC.
// ====================================================================
$var_sql_check = "SELECT COUNT(*)
                  FROM mro_task_materials tm
                  JOIN mro_materials m ON tm.material_id = m.material_id
                  WHERE tm.task_id = $var_task_id
                    AND tm.is_applied IS NOT TRUE
                    AND (m.is_blocking_task IS TRUE OR m.is_blocking_task IS NULL)
                    AND m.stock_balance < tm.planned_qty";
sc_lookup(rs_faltantes, $var_sql_check);

if ({rs_faltantes} === false) {
    sc_error_message("Erro na consulta de disponibilidade de materiais.");
    sc_error_exit();
}

$var_faltantes = !empty({rs_faltantes}) ? (int){rs_faltantes[0][0]} : 0;

if ($var_faltantes > 0) {
    sc_error_message("Liberação bloqueada: ainda existem {$var_faltantes} material(is) sem saldo suficiente no estoque físico.");
    sc_error_exit();
}

// ====================================================================
// 2. Trava de status: so libera JICs que ainda nao foram liberadas
// ====================================================================
if ($var_status != 'PLANNED' && $var_status != 'NOT_STARTED') {
    sc_error_message("A JIC {$var_jic} já foi liberada ou está em outro status ({$var_status}).");
    sc_error_exit();
}

// ====================================================================
// 3. LIBERA PARA O HANGAR
// ====================================================================
sc_exec_sql("UPDATE mro_tasks SET status_code = 'RELEASED', is_blocked_material = false WHERE task_id = $var_task_id");

// 3.1 Audit log (Assinatura Digital)
sc_exec_sql("INSERT INTO mro_task_history (task_id, action_taken, user_login, remarks)
             VALUES ($var_task_id, 'RELEASED_BY_PROVEDORIA', '$var_user',
             'Gated Process: 100% dos materiais disponiveis no estoque fisico - liberado para o hangar (grid_mro_material_release)')");

sc_commit_trans();

// ====================================================================
// 4. Feedback e recarga da grid
// ====================================================================
sc_alert("JIC {$var_jic} liberada para o hangar com sucesso!");
sc_redir(grid_mro_material_release);
